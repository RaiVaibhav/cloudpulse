{
  "name": "cloudpulse-backend",
  "version": "1.0.0",
  "description": "CloudPulse Backend API Service with TypeScript and Express",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "prisma": "^5.21.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2"
  }
}
